{
  "source": "充电平台开放接口对接文档.md",
  "note": "充电(evcharge)域的接口真相源。手工维护，由对接文档转写并以 prod 实测校正。make catalog 时由 tools/extractor/extract.mjs 合并进 catalog.json。全部只读。详见 .scratch/evcharge/DECISION-metadata-source.md。sampleResponse 已按 prod 实测(站点 C3CMHJX/城南园4座西充电站)校正：订单状态实为 chargeStatus(9002充电中/9003已完成)+orderState(1下单/3已支付)，非文档的 orderStatus 英文枚举；pile 含 plotCode、枪口 status(0离线/2空闲/4已插枪)；统计含 chargeTotalTimes。",
  "interfaces": [
    {
      "cmd": "evchargeStationList",
      "domain": "evcharge",
      "explain": "获取充电站点列表（按运营商账号或手机号查询站点）",
      "direction": "callable",
      "readwrite": "read",
      "params": [
        { "name": "useraccount", "required": false, "type": "String", "desc": "运营商账号，和 mobile 至少传一个" },
        { "name": "mobile", "required": false, "type": "String", "desc": "手机号，和 useraccount 至少传一个" },
        { "name": "pageNum", "required": false, "type": "Integer", "desc": "页码，默认 1" },
        { "name": "pageSize", "required": false, "type": "Integer", "desc": "每页条数，默认 10，最大 50" }
      ],
      "sampleBody": { "useraccount": "DLS001", "mobile": "", "pageNum": 1, "pageSize": 10 },
      "sampleResponse": {
        "status": 1,
        "resultCode": 0,
        "message": "业务成功",
        "data": {
          "total": 1,
          "count": 1,
          "currCount": 1,
          "recordList": [
            {
              "plotName": "城南园4座西充电站",
              "plotCode": "C3CMHJX",
              "region": "广东省佛山市禅城区佛山国家高新区城南科技园4座西侧",
              "lng": 113.128616,
              "lat": 22.989117,
              "runningStatus": "1",
              "runningStatusName": "运营中"
            }
          ]
        }
      }
    },
